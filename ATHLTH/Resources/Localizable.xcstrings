            "state": "translated",
            "value": "Annet"
          }
        }
      }
    },
    "Prefer not to say": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ønsker ikke å oppgi"
          }
        }
      }
    },
    "Lose weight": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå ned i vekt"
          }
        }
      }
    },
    "Build muscle": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bygg muskler"
          }
        }
      }
    },
    "Get stronger": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bli sterkere"
          }
        }
      }
    },
    "Improve fitness & endurance": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbedre kondisjon og utholdenhet"
          }
        }
      }
    },
    "Run faster or farther": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Løp raskere eller lengre"
          }
        }
