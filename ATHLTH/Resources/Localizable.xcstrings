{
  "sourceLanguage": "en",
  "strings": {
    "Welcome to ATHLTH": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velkommen til ATHLTH"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te damos la bienvenida a ATHLTH"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Benvenuto in ATHLTH"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎使用 ATHLTH"
          }
        }
      }
    },
    "Move better. Train smarter. Build a complete picture of your training, recovery and progress.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beveg deg bedre. Tren smartere. Få et komplett bilde av trening, restitusjon og fremgang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muévete mejor. Entrena de forma más inteligente. Obtén una visión completa de tu entrenamiento, recuperación y progreso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Muoviti meglio. Allenati in modo più intelligente. Ottieni un quadro completo di allenamento, recupero e progressi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更好地运动，更聪明地训练。全面了解你的训练、恢复和进步。"
          }
        }
      }
    },
    "Continue with Apple": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsett med Apple"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar con Apple"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua con Apple"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Apple 继续"
          }
        }
      }
    },
    "Continue with Email": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsett med e-post"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar con correo electrónico"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua con e-mail"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用电子邮件继续"
          }
        }
      }
    },
    "By continuing, you agree to ATHLTH’s": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved å fortsette godtar du ATHLTHs"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al continuar, aceptas los"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuando, accetti i"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续即表示你同意 ATHLTH 的"
          }
        }
      }
    },
    "Terms of Service": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruksvilkår"
