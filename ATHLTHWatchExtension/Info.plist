<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>ATHLTH</string>
    <key>WKApplication</key>
    <true/>
    <key>WKCompanionAppBundleIdentifier</key>
    <string>com.wesc9.athlth</string>
    <key>WKRunsIndependentlyOfCompanionApp</key>
    <false/>
    <key>NSHealthShareUsageDescription</key>
    <string>ATHLTH reads live heart rate, energy and distance to show your workout metrics on Apple Watch.</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>ATHLTH saves workouts and workout routes from Apple Watch to Apple Health.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>ATHLTH uses your location during outdoor workouts to record your route and distance.</string>
    <key>WKBackgroundModes</key>
    <array>
        <string>workout-processing</string>
    </array>
</dict>
</plist>
