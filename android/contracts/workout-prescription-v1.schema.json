{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athlth.com/schemas/workout-prescription-v1.schema.json",
  "title": "ATHLTH workout prescription – draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sessionId", "name", "blocks"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "sessionId": {"type": "string", "minLength": 1},
    "name": {"type": "string"},
    "blocks": {
      "type": "array",
      "items": {"$ref": "#/$defs/block"}
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "phase"],
      "properties": {
        "id": {"type": "string"},
        "type": {"enum": ["RUN", "STRENGTH", "REST", "INSTRUCTIONS"]},
        "phase": {"enum": ["WARMUP", "MAIN", "RECOVERY", "COOLDOWN"]},
        "durationSeconds": {"type": ["integer", "null"], "minimum": 0},
        "distanceMeters": {"type": ["number", "null"], "minimum": 0},
        "targetPaceSecondsPerKm": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "targetHeartRateZone": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "exerciseId": {"type": ["string", "null"]},
        "reps": {"type": ["integer", "null"], "minimum": 0},
        "weightKg": {"type": ["number", "null"], "minimum": 0},
        "restSeconds": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
