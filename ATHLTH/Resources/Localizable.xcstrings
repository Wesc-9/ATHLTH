    "Missing profile details can be added later in Settings. ATHLTH never requires them to finish onboarding.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Manglende profilopplysninger kan legges inn senere i Innstillinger. ATHLTH krever dem aldri for å fullføre oppsettet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de perfil que falten pueden añadirse más tarde en Ajustes. ATHLTH nunca los exige para terminar la configuración."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati del profilo mancanti possono essere aggiunti in seguito nelle Impostazioni. ATHLTH non li richiede per completare la configurazione."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少的资料可以稍后在“设置”中添加。ATHLTH 不会要求这些信息才能完成设置。"
          }
        }
      }
    },
    "Private by default": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Privat som standard"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Privado de forma predeterminada"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Privato per impostazione predefinita"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认保持私密"
          }
        }
      }
    },
    "Connecting Apple Health does not publish health data. Social sharing is controlled separately.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilkobling til Apple Health publiserer ikke helsedata. Sosial deling styres separat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectar Apple Health no publica tus datos de salud. El uso compartido social se controla por separado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collegare Apple Health non rende pubblici i dati salute. La condivisione social è gestita separatamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 Apple Health 不会公开健康数据。社交分享由单独的设置控制。"
          }
        }
      }
    },
    "Skip for now": {
      "localizations": {
