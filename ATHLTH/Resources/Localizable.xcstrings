{
  "sourceLanguage": "en",
  "strings": {
    "Welcome to ATHLTH": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velkommen til ATHLTH"
          }
        }
      }
    },
    "Move better. Train smarter. Build a complete picture of your training, recovery and progress.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beveg deg bedre. Tren smartere. Få et komplett bilde av trening, restitusjon og fremgang."
          }
        }
      }
    },
    "Continue with Apple": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsett med Apple"
          }
        }
      }
    },
    "Continue with Email": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsett med e-post"
          }
        }
      }
    },
    "By continuing, you agree to ATHLTH’s": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved å fortsette godtar du ATHLTHs"
          }
        }
      }
    },
    "Terms of Service": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruksvilkår"
          }
        }
      }
    },
    "Privacy Policy": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Personvernerklæring"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferdig"
          }
        }
      }
    },
    "Language": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Språk"
          }
        }
      }
    },
    "Choose your username": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg brukernavn"
          }
        }
      }
    },
    "This is how friends will find you. Every ATHLTH username is unique.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slik finner venner deg. Alle ATHLTH-brukernavn er unike."
          }
        }
      }
    },
    "3–20 characters": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "3–20 tegn"
          }
        }
      }
    },
    "Letters, numbers and underscores": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bokstaver, tall og understrek"
          }
        }
      }
    },
    "Can be changed later": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan endres senere"
          }
        }
      }
    },
    "What do you want from ATHLTH?": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva ønsker du å bruke ATHLTH til?"
          }
        }
      }
    },
    "Choose the areas that matter to you, then select one main goal.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg områdene som betyr mest for deg, og velg deretter ett hovedmål."
          }
        }
      }
    },
    "Main goal": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hovedmål"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsett"
          }
        }
      }
    },
    "Connect your health": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til helsedata"
          }
        }
      }
    },
    "Apple Health can fill in available profile basics and add workouts, heart rate, sleep, recovery and activity data. Everything here is optional.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health kan fylle inn tilgjengelige profilopplysninger og legge til trening, puls, søvn, restitusjon og aktivitetsdata. Alt her er valgfritt."
          }
        }
      }
    },
    "Connect": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til"
          }
        }
      }
    },
    "Connected": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilkoblet"
          }
        }
      }
    },
    "Available from Apple Health": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilgjengelig fra Apple Health"
          }
        }
      }
    },
    "Date of birth": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fødselsdato"
          }
        }
      }
    },
    "Sex": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjønn"
          }
        }
      }
    },
    "Weight": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vekt"
          }
        }
      }
    },
    "Height": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Høyde"
          }
        }
      }
    },
    "Missing profile details can be added later in Settings. ATHLTH never requires them to finish onboarding.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Manglende profilopplysninger kan legges inn senere i Innstillinger. ATHLTH krever dem aldri for å fullføre oppsettet."
          }
        }
      }
    },
    "Private by default": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Privat som standard"
          }
        }
      }
    },
    "Connecting Apple Health does not publish health data. Social sharing is controlled separately.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilkobling til Apple Health publiserer ikke helsedata. Sosial deling styres separat."
          }
        }
      }
    },
    "Skip for now": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hopp over foreløpig"
          }
        }
      }
    },
    "You’re ready": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er klar"
          }
        }
      }
    },
    "Your main goal": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt hovedmål"
          }
        }
      }
    },
    "Add later": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til senere"
          }
        }
      }
    },
    "Spotify and Home Assistant are configured later in Settings.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify og Home Assistant konfigureres senere i Innstillinger."
          }
        }
      }
    },
    "Enter ATHLTH": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå inn i ATHLTH"
          }
        }
      }
    },
    "Welcome back": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velkommen tilbake"
          }
        }
      }
    },
    "Create your ATHLTH account": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprett ATHLTH-konto"
          }
        }
      }
    },
    "Sign in with your email and password.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg inn med e-post og passord."
          }
        }
      }
    },
    "Use your email to create an ATHLTH account.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk e-postadressen din for å opprette en ATHLTH-konto."
          }
        }
      }
    },
    "Sign In": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg inn"
          }
        }
      }
    },
    "Create Account": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprett konto"
          }
        }
      }
    },
    "Email address": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "E-postadresse"
          }
        }
      }
    },
    "Password": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Passord"
          }
        }
      }
    },
    "Confirm password": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekreft passord"
          }
        }
      }
    },
    "I agree to the Terms and Privacy Policy": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg godtar bruksvilkårene og personvernerklæringen"
          }
        }
      }
    },
    "Terms": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilkår"
          }
        }
      }
    },
    "Forgot password?": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Glemt passord?"
          }
        }
      }
    },
    "Email": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "E-post"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukk"
          }
        }
      }
    },
    "Reset Password": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbakestill passord"
          }
        }
      }
    },
    "Send reset link": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Send lenke for tilbakestilling"
          }
        }
      }
    },
    "Check your email": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjekk e-posten din"
          }
        }
      }
    },
    "If an ATHLTH account exists for this email address, password-reset instructions will be sent.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis det finnes en ATHLTH-konto med denne e-postadressen, sendes instruksjoner for tilbakestilling av passord."
          }
        }
      }
    },
    "Enter a valid email address.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn en gyldig e-postadresse."
          }
        }
      }
    },
    "Password must contain at least 8 characters.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Passordet må inneholde minst 8 tegn."
          }
        }
      }
    },
    "The passwords do not match.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Passordene er ikke like."
          }
        }
      }
    },
    "Please accept the Terms and Privacy Policy.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du må godta bruksvilkårene og personvernerklæringen."
          }
        }
      }
    },
    "Username": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brukernavn"
          }
        }
      }
    },
    "Only a–z, 0–9 and _": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun a–z, 0–9 og _"
          }
        }
      }
    },
    "Suggestions for you": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forslag til deg"
          }
        }
      }
    },
    "What do you want to achieve?": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva ønsker du å oppnå?"
          }
        }
      }
    },
    "Choose the goal that matters most right now. You can change it later.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg målet som betyr mest for deg akkurat nå. Du kan endre det senere."
          }
        }
      }
    },
    "Anything else you're interested in?": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er det noe annet du er interessert i?"
          }
        }
      }
    },
    "Choose all that apply. These help ATHLTH prioritize features, content and future plans for you.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg alt som passer. Dette hjelper ATHLTH med å prioritere funksjoner, innhold og fremtidige planer for deg."
          }
        }
      }
    },
    "Allow ATHLTH to use the goals and interests you choose to personalize ATHLTH offers.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat at ATHLTH bruker målene og interessene du velger til å tilpasse ATHLTH-tilbud."
          }
        }
      }
    },
    "Optional. You can continue without enabling this and change it later in Settings.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfritt. Du kan fortsette uten å aktivere dette og endre det senere i Innstillinger."
          }
        }
      }
    },
    "This applies only to goals and interests you choose in ATHLTH. Apple Health / HealthKit data is not used for offer targeting.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette gjelder bare mål og interesser du velger i ATHLTH. Data fra Apple Health / HealthKit brukes ikke til målretting av tilbud."
          }
        }
      }
    },
    "Bring your health and training data into ATHLTH.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta med helse- og treningsdataene dine inn i ATHLTH."
          }
        }
      }
    },
    "Apple Health": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health"
          }
        }
      }
    },
    "Workouts, heart rate, sleep, activity and recovery": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Treningsøkter, puls, søvn, aktivitet og restitusjon"
          }
        }
      }
    },
    "Apple Watch": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch"
          }
        }
      }
    },
    "Imported from Apple Health": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Importert fra Apple Health"
          }
        }
      }
    },
    "7-day ATHLTH+ trial active": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "7 dagers prøveperiode med ATHLTH+ er aktiv"
          }
        }
      }
    },
    "Background Health sync is included during your trial.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakgrunnssynkronisering av helsedata er inkludert i prøveperioden."
          }
        }
      }
    },
    "ATHLTH is ready around your goal.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "ATHLTH er klart rundt målet ditt."
          }
        }
      }
    },
    "Start ATHLTH": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Start ATHLTH"
          }
        }
      }
    },
    "Keep my ATHLTH+ benefits after the trial": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold ATHLTH+-fordelene mine etter prøveperioden"
          }
        }
      }
    },
    "See Monthly and Yearly plans before entering ATHLTH.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se måneds- og årsabonnement før du går inn i ATHLTH."
          }
        }
      }
    },
    "Complete the required field to continue.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fyll ut det obligatoriske feltet for å fortsette."
          }
        }
      }
    },
    "Create an account, then verify your email before continuing.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprett en konto, og bekreft deretter e-postadressen din før du fortsetter."
          }
        }
      }
    },
    "Email account": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "E-postkonto"
          }
        }
      }
    },
    "Email verification required": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "E-postbekreftelse kreves"
          }
        }
      }
    },
    "Your ATHLTH account has been created, but sign-in is not completed until the email address is verified.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "ATHLTH-kontoen din er opprettet, men innloggingen er ikke fullført før e-postadressen er bekreftet."
          }
        }
      }
    },
    "Back to sign in": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbake til innlogging"
          }
        }
      }
    },
    "If an ATHLTH account exists for this email address, a password-reset link has been sent. Open the link on this iPhone to return to ATHLTH and choose a new password.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis det finnes en ATHLTH-konto med denne e-postadressen, er en lenke for å tilbakestille passordet sendt. Åpne lenken på denne iPhonen for å gå tilbake til ATHLTH og velge et nytt passord."
          }
        }
      }
    },
    "Set a new password": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angi et nytt passord"
          }
        }
      }
    },
    "Choose a new password for your ATHLTH account.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg et nytt passord for ATHLTH-kontoen din."
          }
        }
      }
    },
    "New password": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nytt passord"
          }
        }
      }
    },
    "Confirm new password": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekreft nytt passord"
          }
        }
      }
    },
