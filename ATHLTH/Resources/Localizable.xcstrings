    "Choose your username": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg brukernavn"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tu nombre de usuario"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il tuo nome utente"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择用户名"
          }
        }
      }
    },
    "This is how friends will find you. Every ATHLTH username is unique.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slik finner venner deg. Alle ATHLTH-brukernavn er unike."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así podrán encontrarte tus amigos. Cada nombre de usuario de ATHLTH es único."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È così che gli amici potranno trovarti. Ogni nome utente ATHLTH è unico."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "朋友将通过它找到你。每个 ATHLTH 用户名都是唯一的。"
          }
        }
      }
    },
    "3–20 characters": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "3–20 tegn"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "3–20 caracteres"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "3–20 caratteri"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3–20 个字符"
          }
        }
      }
    },
    "Letters, numbers and underscores": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bokstaver, tall og understrek"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Letras, números y guiones bajos"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lettere, numeri e trattini bassi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "字母、数字和下划线"
          }
        }
      }
    },
    "Can be changed later": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan endres senere"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se puede cambiar más tarde"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Può essere modificato in seguito"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以后可以更改"
          }
        }
      }
    },
    "What do you want from ATHLTH?": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva ønsker du å bruke ATHLTH til?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué quieres conseguir con ATHLTH?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa vuoi ottenere da ATHLTH?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你希望通过 ATHLTH 实现什么？"
          }
        }
      }
    },
    "Choose the areas that matter to you, then select one main goal.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg områdene som betyr mest for deg, og velg deretter ett hovedmål."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige las áreas que te importan y después selecciona un objetivo principal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli le aree che ti interessano e poi seleziona un obiettivo principale."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择对你重要的领域，然后选择一个主要目标。"
          }
        }
      }
    },
    "Main goal": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hovedmål"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Objetivo principal"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Obiettivo principale"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主要目标"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsett"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续"
          }
        }
      }
    },
    "Connect your health": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til helsedata"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta tus datos de salud"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega i tuoi dati salute"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接你的健康数据"
          }
        }
      }
    },
    "Apple Health can fill in available profile basics and add workouts, heart rate, sleep, recovery and activity data. Everything here is optional.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health kan fylle inn tilgjengelige profilopplysninger og legge til trening, puls, søvn, restitusjon og aktivitetsdata. Alt her er valgfritt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health puede completar datos básicos disponibles y añadir entrenamientos, frecuencia cardíaca, sueño, recuperación y actividad. Todo aquí es opcional."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health può compilare i dati di base disponibili e aggiungere allenamenti, frequenza cardiaca, sonno, recupero e attività. Tutto è facoltativo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health 可以填写可用的基本资料，并添加训练、心率、睡眠、恢复和活动数据。此处所有内容均为可选。"
          }
        }
      }
    },
